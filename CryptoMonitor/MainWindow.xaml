<Window x:Class="CryptoMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="CryptoMonitor" Height="450" Width="900">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Таблица -->
        <DataGrid x:Name="CoinsTable"
                  Grid.Column="0"
                  Grid.Row="0"
                  AutoGenerateColumns="True"
                  Margin="5"
                  SelectionChanged="CoinsTable_SelectionChanged"/>

        <Button Content="Анализ"
                Grid.Row="1"
                Grid.Column="1"
                Margin="5"
                Click="OpenAnalysis_Click"/>

        <!--График-->
        <ScottPlot:WpfPlot x:Name="CryptoPlot"
                       Grid.Column="1"
                       Margin="5"/>


    </Grid>
</Window>

