<Window x:Class="CryptoMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="CryptoMonitor" Height="450" Width="900">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid ItemsSource="{Binding Coins}"
                  SelectedItem="{Binding SelectedCoin}"
                  AutoGenerateColumns="True"/>

        <Button Content="Анализ"
                Grid.Row="1"
                Grid.Column="1"
                Margin="5"
                Command="{Binding OpenAnalysisCommand}"/>

        <Border Background="#AAFFFFFF" 
                CornerRadius="5"
                Padding="5"
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom"
                Margin="0,10,10,0"
                Width="150">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Chart:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="ChartTypeCombo" Width="80" SelectionChanged="ChartTypeCombo_SelectionChanged">
                    <ComboBoxItem Content="Line" IsSelected="True"/>
                    <ComboBoxItem Content="Candlestick"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <ScottPlot:WpfPlot x:Name="CryptoPlot"
                           Grid.Column="1"
                           Margin="5,5,-17,5"/>

        <Border Grid.ColumnSpan="2"
                Background="#E6FFFFFF"
                CornerRadius="8"
                Padding="15,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Visibility="{Binding IsLoadingCoins, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding LoadingMessage}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>