<Window x:Class="CryptoMonitor.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Глубокий анализ"
        Height="650"
        Width="950"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <Border Grid.Row="0" Margin="0,0,0,15"
                Background="{StaticResource PanelDark}"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="Индикатор:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="AnalysisTypeCombo" 
                              Width="200" MinHeight="34"
                              Foreground="{StaticResource TextMain}"
                              VerticalAlignment="Center">
                        <ComboBox.Template>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton" Focusable="false" ClickMode="Press"
                                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{StaticResource PanelDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4">
                                                    <Path x:Name="Arrow" Fill="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                                      Content="{TemplateBinding SelectionBoxItem}" 
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                      Margin="10,6,30,6" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                        <Border x:Name="DropDownBorder" Background="{StaticResource BgDark}" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}">
                                            <ScrollViewer Margin="0,2" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </ComboBox.Template>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="{StaticResource BgDark}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2B3655"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="Объем торгов" IsSelected="True"/>
                        <ComboBoxItem Content="Цена + SMA/EMA"/>
                        <ComboBoxItem Content="Полосы Боллинджера"/>
                        <ComboBoxItem Content="Индикатор RSI"/>
                        <ComboBoxItem Content="Индикатор MACD"/>
                        <ComboBoxItem Content="Parabolic SAR"/>
                        <ComboBoxItem Content="Стохастик"/>
                        <ComboBoxItem Content="Облако Ишимоку"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <Button Content="💾 График (PNG)" 
                            Margin="0,0,10,0" Padding="15,6"
                            Background="#3A506B"
                            Click="BtnExportPng_Click"/>
                            
                    <Button Content="📊 Данные (CSV)" 
                            Margin="0,0,10,0" Padding="15,6"
                            Background="#5BC0BE" Foreground="#0B132B"
                            Click="BtnExportCsv_Click"/>

                    <Button Content="📄 Отчёт (PDF)" 
                            Padding="15,6"
                            Background="#E63946" Foreground="White"
                            Click="BtnExportPdf_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Рабочая область графика -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelDark}" 
                CornerRadius="8" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1">
            <Grid>
                <ScottPlot:WpfPlot x:Name="MainPlot" Margin="10"/>
                
                <!-- Кнопка подсказки в углу графика -->
                <Button x:Name="BtnIndicatorHelp"
                        Click="BtnIndicatorHelp_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,20,20,0"
                        Width="26" Height="26"
                        Content="?"
                        Cursor="Hand"
                        Padding="0"
                        ToolTip="Что показывает этот индикатор?">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3A506B"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{StaticResource TextMuted}" 
                                                BorderThickness="1" 
                                                CornerRadius="13">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHover}"/>
                                                <Setter Property="Foreground" Value="#0B132B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Вспливающая подсказка -->
                <Popup x:Name="HelpPopup" StaysOpen="False" AllowsTransparency="True" Placement="Left">
                    <Border Background="{StaticResource PanelDark}" 
                            BorderBrush="{StaticResource AccentHover}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            MaxWidth="350" Padding="15">
                        <StackPanel>
                            <TextBlock Text="О индикаторе" Foreground="{StaticResource AccentHover}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="HelpPopupText" 
                                       TextWrapping="Wrap" 
                                       Foreground="{StaticResource TextMain}" 
                                       FontSize="13" 
                                       LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>