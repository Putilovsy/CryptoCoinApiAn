<Window x:Class="CryptoMonitor.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Analysis"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- Верхний график -->
        <ScottPlot:WpfPlot x:Name="PricePlot" Grid.Row="0" Margin="5"/>

        <!-- Нижний график RSI -->
        <ScottPlot:WpfPlot x:Name="RsiPlot" Grid.Row="1" Margin="5"/>
    </Grid>

</Window>